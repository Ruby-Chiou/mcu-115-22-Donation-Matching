# System files
.DS_Store
Thumbs.db

# Force ignore general folders
/node_modules/
/dist/
.angular/

# Supabase CLI（本機連結／暫存，勿 commit）
supabase/.branches
supabase/.temp
supabase/.env
supabase/.env.keys
supabase/.env.local
supabase/.env.*.local

# 本機密鑰。信箱應用程式密碼與服務金鑰放在 Supabase secret，不要進 git。
.env
.env.*
!.env.example
*.pem
**/credentials.json
**/service-account*.json

